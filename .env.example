# Used by docker compose to provision the Postgres container and to let the
# backend/frontend containers find each other. Copy to .env before `task up`.
# Per-package dev overrides live in backend/.env and frontend/.env instead.

POSTGRES_USER=arr
POSTGRES_PASSWORD=arr
POSTGRES_DB=arr
POSTGRES_PORT=5432

BACKEND_PORT=3333
FRONTEND_PORT=3000

APP_KEY=

# OIDC (PocketID). Optional: leave empty to configure SSO from the onboarding
# UI instead. When set, these take precedence over the database config
# (cf. docs/adr — AuthSettingsProvider precedence).
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
DISABLE_PASSWORD_LOGIN=false

# Frontend connector: "http" talks to the real backend, "fake" runs fully
# offline against FakeArrConnector (cf. docs/phase-0, task dev:fake).
VITE_CONNECTOR=http

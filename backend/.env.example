# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# better-auth session/cookie signing key (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=arr
DB_PASSWORD=arr
DB_DATABASE=arr

#--------------------------------------------------------------------
# CORS / better-auth trustedOrigins (the browser-facing frontend origin(s) —
# required for OIDC sign-in, cf. instance.ts)
#--------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

#--------------------------------------------------------------------
# Optional: pre-create *arr instances at boot instead of going through the
# onboarding wizard (cf. docs/adr/0010). Leave unset to configure them from
# the UI instead.
#--------------------------------------------------------------------
# SONARR_URL=http://localhost:8989
# SONARR_API_KEY=
# RADARR_URL=http://localhost:7878
# RADARR_API_KEY=
# LIDARR_URL=http://localhost:8686
# LIDARR_API_KEY=
